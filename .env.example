# NetLift — environment variable template
#
# Copy this file to .env and fill in the values for your machine.
# .env is in .gitignore and must NEVER be committed.
# This file contains names only. Never put a real secret in it.

# --- Experiment tracking ---
# MLflow 3.x no longer supports the plain ./mlruns file store.
# A SQLite backend is required. See docs/environment.md.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=netlift

# --- Data locations, relative to the repository root ---
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed

# --- Reproducibility ---
# Every script, split and model seeds from this single value.
RANDOM_SEED=42

# --- Logging ---
LOG_LEVEL=INFO

# --- Azure, milestone 6 only. Leave empty until then. ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
